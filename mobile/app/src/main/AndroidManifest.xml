<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AgendaLarm"
        tools:targetApi="33">

        <!-- M-05 · Alarmas del día · estado vacío: pantalla de arranque de la app. -->
        <activity
            android:name=".ui.alarmasdiavacio.M05AlarmasDiaVacioActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- M-07 · Resumen de mañana: se abre al avanzar de día desde M-05. -->
        <activity
            android:name=".ui.resumenmanana.M07ResumenMananaActivity"
            android:exported="false" />

        <!-- M-04 · Alarmas del día: se abre desde el botón de M-07. -->
        <activity
            android:name=".ui.alarmasdia.M04AlarmasDelDiaActivity"
            android:exported="false"
            android:parentActivityName=".ui.resumenmanana.M07ResumenMananaActivity" />

        <!-- M-06 · Detalle de la alarma: se abre desde las tarjetas de M-04 (no es un punto de entrada). -->
        <activity
            android:name=".ui.detallealarma.M06DetalleAlarmaActivity"
            android:exported="false"
            android:parentActivityName=".ui.alarmasdia.M04AlarmasDelDiaActivity" />

        <!-- M-09 · ¿Cómo quieres confirmar que despertaste?: se abre desde «Editar Alarma» en M-06. -->
        <activity
            android:name=".ui.metodoconfirmacion.M09MetodoConfirmacionActivity"
            android:exported="false"
            android:parentActivityName=".ui.detallealarma.M06DetalleAlarmaActivity" />

        <!-- M-11 · Levántate para apagar la alarma: se abre al elegir «Ponerte de pie y sostener el teléfono» en M-09. -->
        <activity
            android:name=".ui.levantateapagar.M11LevantateApagarActivity"
            android:exported="false"
            android:parentActivityName=".ui.metodoconfirmacion.M09MetodoConfirmacionActivity" />

        <!-- M-12 · Alarma cumplida: se abre al completar la barra de M-11 y vuelve sola a M-09. -->
        <activity
            android:name=".ui.alarmacumplida.M12AlarmaCumplidaActivity"
            android:exported="false"
            android:parentActivityName=".ui.metodoconfirmacion.M09MetodoConfirmacionActivity" />
    </application>

</manifest>
