<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AgendaLarm"
        tools:targetApi="33">

        <!-- M-04 · Alarmas del día: pantalla de arranque de la app. -->
        <activity
            android:name=".ui.alarmasdia.M04AlarmasDelDiaActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- M-06 · Detalle de la alarma: se abre desde las tarjetas de M-04 (no es un punto de entrada). -->
        <activity
            android:name=".ui.detallealarma.M06DetalleAlarmaActivity"
            android:exported="false"
            android:parentActivityName=".ui.alarmasdia.M04AlarmasDelDiaActivity" />

        <!-- M-09 · ¿Cómo quieres confirmar que despertaste?: aún no lo abre ninguna pantalla (ver src/debug). -->
        <activity
            android:name=".ui.metodoconfirmacion.M09MetodoConfirmacionActivity"
            android:exported="false" />

        <!-- M-11 · Levántate para apagar la alarma: aún no la abre ninguna pantalla (ver src/debug). -->
        <activity
            android:name=".ui.levantateapagar.M11LevantateApagarActivity"
            android:exported="false" />
    </application>

</manifest>
