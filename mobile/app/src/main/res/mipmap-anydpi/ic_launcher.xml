<?xml version="1.0" encoding="utf-8"?>
<!--
  Ícono de la app: el mismo emoji del reloj despertador que usan como favicon las pantallas de web
  (<text>⏰</text> en web/*.html), en su versión Noto Color Emoji de Google (ver assets/licencias/Noto-Emoji-OFL.txt).
  El primer plano es un PNG de 432 × 432 px (108 dp a xxxhdpi) con el dibujo dentro de la zona segura de 66 dp;
  el fondo es el color de superficie de la app. Con minSdk 26 basta este ícono adaptable, sin PNG heredados.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
