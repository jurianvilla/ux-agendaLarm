<?xml version="1.0" encoding="utf-8"?>
<!--
  Encabezado de pantalla: franja blanca de 70 dp con el nombre de la pantalla, su tipo de acceso y su código «M#»,
  tal como aparece en los 15 mockups. Se incluye con:

      <include
          android:id="@+id/encabezado"
          layout="@layout/include_encabezado_pantalla"
          app:acceso="@{@string/m04_acceso}"
          app:codigo="@{@string/m04_codigo}"
          app:titulo="@{@string/m04_titulo}" />

  Variante de título de dos líneas (M-09): app:tituloDoble="@{true}". El título sube y se corre a la izquierda y el
  acceso se le pega, como en ese mockup. Las distancias van como relleno de los propios textos (no como margen)
  porque data binding sólo puede elegirlas así sin adaptadores propios.

  Dos capas: la exterior es la franja blanca, que llega hasta el borde superior y recibe como relleno la altura
  de la barra de estado (BaseActivity.aplicarInsets); la interior mide 70 dp aparte de ese relleno, porque
  minHeight cuenta el relleno y la franja saldría más baja de lo dibujado.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="titulo"
            type="String" />

        <variable
            name="acceso"
            type="String" />

        <variable
            name="codigo"
            type="String" />

        <variable
            name="tituloDoble"
            type="boolean" />
    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/tarjeta">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/encabezado_altura"
            android:paddingBottom="@{tituloDoble ? @dimen/encabezado_relleno_inferior_doble : @dimen/encabezado_relleno_inferior}">

            <TextView
                android:id="@+id/texto_titulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:layout_marginEnd="@dimen/margen_pantalla"
                android:paddingStart="@{tituloDoble ? @dimen/encabezado_titulo_doble_margen_inicio : @dimen/margen_pantalla}"
                android:paddingEnd="0dp"
                android:paddingTop="@{tituloDoble ? @dimen/encabezado_titulo_doble_margen_superior : @dimen/encabezado_titulo_margen_superior}"
                android:text="@{titulo}"
                android:textAppearance="@style/TextAppearance.AgendaLarm.Encabezado"
                app:layout_constraintEnd_toStartOf="@id/texto_codigo"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:targetApi="28"
                tools:text="Alarmas del día" />

            <TextView
                android:id="@+id/texto_acceso"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/margen_pantalla"
                android:paddingTop="@{tituloDoble ? @dimen/encabezado_acceso_doble_margen_superior : @dimen/encabezado_acceso_margen_superior}"
                android:text="@{acceso}"
                android:textAppearance="@style/TextAppearance.AgendaLarm.Micro"
                app:layout_constraintEnd_toEndOf="@id/texto_titulo"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/texto_titulo"
                tools:text="Requiere autenticación" />

            <TextView
                android:id="@+id/texto_codigo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/encabezado_codigo_margen_superior"
                android:layout_marginEnd="@dimen/encabezado_codigo_margen_final"
                android:text="@{codigo}"
                android:textAppearance="@style/TextAppearance.AgendaLarm.Micro"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="M4" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
</layout>
