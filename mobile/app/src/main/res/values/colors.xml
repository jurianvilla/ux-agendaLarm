<?xml version="1.0" encoding="utf-8"?>
<!--
  Tokens semánticos de color (equivalen a las variables de :root en web/css/styles.css).
  Los layouts, estilos y drawables usan SÓLO estos nombres; cada uno apunta a un paso de la paleta
  primitiva de colors_paleta.xml. Los que no tienen paso equivalente están muestreados del mockup
  y se marcan como tales.
-->
<resources>

    <!-- Superficies -->
    <color name="superficie">@color/primario_50</color>          <!-- fondo de pantalla -->
    <color name="tarjeta">@color/neutros_50</color>              <!-- tarjetas, campos y franja del encabezado -->
    <color name="blanco">#FFFFFF</color>

    <!-- Texto -->
    <color name="texto_primario">@color/primario_990</color>     <!-- títulos y contenido principal -->
    <color name="texto_secundario">@color/neutros_700</color>    <!-- detalles, ayudas, microcopia -->
    <color name="texto_etiqueta">@color/primario_600</color>     <!-- etiquetas de campos -->
    <color name="texto_marca">@color/primario_500</color>        <!-- texto introductorio y enlaces -->

    <!-- Bordes e iconos -->
    <color name="borde">@color/neutros_300</color>               <!-- divisores y bordes discretos -->
    <color name="borde_tarjeta">@color/informativo_800</color>   <!-- contorno de tarjetas y campos (mockups) -->
    <color name="icono">@color/primario_600</color>

    <!-- Acción principal (ámbar en mockups: relleno 900, borde primario 990) -->
    <color name="boton">@color/acento_900</color>
    <color name="boton_pulsado">@color/acento_990</color>        <!-- «Interacción oscurece un paso» -->
    <color name="boton_borde">@color/primario_990</color>
    <color name="boton_deshabilitado">@color/neutros_100</color>
    <color name="boton_texto_deshabilitado">@color/neutros_500</color>
    <color name="boton_borde_deshabilitado">@color/neutros_200</color>

    <!-- Acción destructiva (rojo en mockups) -->
    <color name="destructivo_fondo">@color/error_200</color>
    <color name="destructivo_borde">@color/error_800</color>

    <!-- Estados semánticos -->
    <color name="exito">@color/confirmacion_700</color>
    <color name="error">@color/error_500</color>
    <color name="advertencia_fondo">@color/atencion_100</color>
    <color name="advertencia_texto">@color/atencion_900</color>

    <!-- Interruptor (pista apagada y su borde: muestreados de M-04 / M-09) -->
    <color name="interruptor_pista_encendida">@color/primario_990</color>
    <color name="interruptor_pista_apagada">#E6E5EA</color>
    <color name="interruptor_borde_apagado">#C0BFC4</color>
    <color name="interruptor_pulgar">@color/neutros_50</color>

    <!-- Divisores sobre la superficie de la pantalla (M-06: línea blanca de 1 dp) -->
    <color name="divisor">@color/neutros_50</color>

    <!-- Ilustración de la campana de M-06 (muestreados del mockup: no tienen paso equivalente en la paleta) -->
    <color name="campana_clara">#F7D460</color>
    <color name="campana_oscura">#E58E14</color>

    <!-- Barra de progreso (M-11): pista y relleno -->
    <color name="progreso_pista">@color/neutros_100</color>
    <color name="progreso_relleno">@color/primario_990</color>

    <!-- Ilustración del gesto de M-11 (muestreados del mockup: no tienen paso equivalente en la paleta) -->
    <color name="gesto_cuerpo">#3D4753</color>
    <color name="gesto_estela">#2A77C1</color>

    <!-- Ilustración de la cama de M-05 -->
    <color name="ilustracion_cama">#000000</color>

    <!-- Marca de confirmación de M-12 -->
    <color name="marca_cumplida">#10C611</color>

    <!-- Fondo del ícono de la app -->
    <color name="ic_launcher_background">@color/superficie</color>

    <!-- Pulsación (ripple): primario_990 al 12 % -->
    <color name="pulsacion">#1F0B0F1A</color>
</resources>
